# Copy to .env and fill in real values. Never commit the real .env file.

# --- App ---
ENV=local
APP_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (Postgres + pgvector), added in Phase 1 ---
# Non-default host port: see the comment in docker-compose.yml about
# pre-existing native Postgres/Redis services on 5432/6379 on this machine.
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5544/opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot

# --- Redis (cache, rate limiting), added in Phase 1 ---
REDIS_URL=redis://localhost:6399/0

# --- LLM: Groq (OpenAI-compatible API), added in Phase 3 ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Langfuse observability, added in Phase 6 ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend, added in Phase 8 ---
VITE_API_BASE_URL=http://localhost:8000
